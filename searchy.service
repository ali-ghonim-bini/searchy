[Unit]
Description=Searchy Desktop Search
# Start only inside a graphical session, after WAYLAND_DISPLAY is exported.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
# install.sh fills in the project location below.
Type=dbus
BusName=io.github.alighonimbini.Searchy
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=-@PROJECT_DIR@/.env
Environment=GDK_BACKEND=wayland
ExecStart=/usr/bin/python3 -m app.main
# Keep background indexing out of the way of interactive work.
Nice=10
IOSchedulingClass=idle
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
